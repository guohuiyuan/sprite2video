{
  "name": "sprite2video",
  "version": "1.0.0",
  "license": "AGPL-3.0",
  "private": true,
  "description": "Character-sprite-driven programmatic explainer video studio & Agent Skills (Capdim 16:9 & Dafeiyu 9:16 + OneTake motion + action-bound SFX + Bilibili publish pack)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:dafeiyu": "remotion render src/index.ts VerticalDafeiyuDemo out/dafeiyu-demo.mp4",
    "render:capdim": "remotion render src/index.ts HorizontalCapdimDemo out/capdim-demo.mp4",
    "still:dafeiyu": "remotion still src/index.ts VerticalDafeiyuDemo out/dafeiyu-frame.png --frame=45",
    "still:capdim": "remotion still src/index.ts HorizontalCapdimDemo out/capdim-frame.png --frame=45",
    "still:cover16x9": "remotion still src/index.ts WellSpokenCover16x9 out/cover-16x9.png",
    "still:cover4x3": "remotion still src/index.ts WellSpokenCover4x3 out/cover-4x3.png",
    "still:cover3x4": "remotion still src/index.ts WellSpokenCover3x4 out/cover-3x4.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.240"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.240",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
