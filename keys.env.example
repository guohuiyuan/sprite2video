# 复制本文件为 keys.env（已被 .gitignore 忽略），或直接配置同名环境变量
# 图像生成 Key（https://latent.moe/dashboard/keys，前缀 lat_sk_）
LATENT_IMAGE_KEY=lat_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 语音合成 Key（https://audio.latent.moe/keys，前缀 lat_tk_，可选）
LATENT_AUDIO_KEY=lat_tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：仅在列出 Latent Audio 全部音色列表时需要
# LATENT_COOKIE=__Secure-authjs.session-token=...; cf_clearance=...
